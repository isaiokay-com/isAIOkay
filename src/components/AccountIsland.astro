---
import AuthControl from "./islands/AuthControl";
import { getCurrentIdentity } from "../services/auth";
import { getRuntimeEnv } from "../lib/runtime";

const env = getRuntimeEnv(Astro.locals);
const identity = await getCurrentIdentity(Astro.request, env);
---
<div class="flex min-h-11 items-center gap-3" aria-label="Account controls">
  <AuthControl client:load authenticated={Boolean(identity)} name={identity?.name ?? null} image={identity?.image ?? null} username={identity?.profile.githubUsername ?? null} />
</div>

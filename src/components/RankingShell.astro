---
import RankingControls from "./islands/RankingControls";
import RankingTable from "./RankingTable.astro";
import type { RankingItem } from "../types";
interface Props {
  items: RankingItem[];
  selectedSlug: string | null;
  selectedPeriod: "live" | "24h" | "7d";
  selectedSort: "recommended" | "result" | "usage" | "improving" | "degrading";
}
const props = Astro.props as Props;
---
<section id="ranking" class="ranking-section" aria-label="AI coding model ranking">
  <div class="page-inner ranking-inner">
    <RankingControls client:load selectedPeriod={props.selectedPeriod} selectedSort={props.selectedSort} />
    <RankingTable items={props.items} selectedSlug={props.selectedSlug} rankOffset={0} showRankMovement={props.selectedSort === "recommended"} />
  </div>
</section>

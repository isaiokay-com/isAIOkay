---
import type { ModelHistoryPoint } from "../types";

interface Props {
  points: ModelHistoryPoint[];
  modelName: string;
}

const { points, modelName } = Astro.props;
const width = 1120;
const height = 400;
const padding = { top: 20, right: 18, bottom: 42, left: 48 };
const plotWidth = width - padding.left - padding.right;
const plotHeight = height - padding.top - padding.bottom;
const startAt = points[0]?.at ?? 0;
const endAt = points.at(-1)?.at ?? startAt;
const timeRange = Math.max(1, endAt - startAt);
const x = (at: number) => padding.left + ((at - startAt) / timeRange) * plotWidth;
const y = (score: number) => padding.top + (1 - Math.max(0, Math.min(100, score)) / 100) * plotHeight;
const dateLabel = (at: number) => new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" }).format(at);
const series = [
  { key: "overallScore", label: "Developer Signal", className: "overall" },
  { key: "resultQualityScore", label: "Result quality", className: "quality" },
  { key: "usageEfficiencyScore", label: "Usage efficiency", className: "value" }
] as const;
const gridValues = [0, 25, 50, 75, 100];
const middleAt = points.length > 2 ? points[Math.floor((points.length - 1) / 2)]?.at : null;
---
<figure class="model-history-figure">
  <div class="model-history-legend" aria-hidden="true">
    {series.map((line) => <span class={`legend-${line.className}`}><i></i>{line.label}</span>)}
  </div>
  {points.length > 0 ? (
    <svg class="model-history-chart" viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby="history-chart-title history-chart-description" preserveAspectRatio="none">
      <title id="history-chart-title">{modelName} score history</title>
      <desc id="history-chart-description">Daily Developer Signal, result quality, and usage efficiency scores from {dateLabel(startAt)} to {dateLabel(endAt)}.</desc>
      {gridValues.map((value) => <g class="history-gridline">
        <line x1={padding.left} x2={width - padding.right} y1={y(value)} y2={y(value)} />
        <text x={padding.left - 12} y={y(value) + 4} text-anchor="end">{value}</text>
      </g>)}
      {series.map((line) => <polyline
        class={`history-series history-series--${line.className}`}
        points={points.map((point) => `${x(point.at).toFixed(1)},${y(point[line.key]).toFixed(1)}`).join(" ")}
        fill="none"
        vector-effect="non-scaling-stroke"
      />)}
      {points.map((point) => <circle class="history-point" cx={x(point.at)} cy={y(point.overallScore)} r="3" vector-effect="non-scaling-stroke">
        <title>{dateLabel(point.at)}: Developer Signal {point.overallScore}/100</title>
      </circle>)}
      <g class="history-axis-labels">
        <text x={padding.left} y={height - 10} text-anchor="start">{dateLabel(startAt)}</text>
        {middleAt && <text x={x(middleAt)} y={height - 10} text-anchor="middle">{dateLabel(middleAt)}</text>}
        {endAt !== startAt && <text x={width - padding.right} y={height - 10} text-anchor="end">{dateLabel(endAt)}</text>}
      </g>
    </svg>
  ) : (
    <div class="model-history-empty">
      <strong>No completed daily snapshot yet</strong>
      <p>The model is listed and accepting ratings. Its first historical point appears after a complete scoring run includes eligible reports.</p>
    </div>
  )}
  <figcaption>Scores are daily snapshots of eligible, recency-weighted developer ratings—not benchmark results.</figcaption>
</figure>

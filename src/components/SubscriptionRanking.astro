---
import type { SubscriptionPeriod, SubscriptionRankingItem } from "../types";

interface Props {
  items: SubscriptionRankingItem[];
  period: SubscriptionPeriod;
  privacyMinimumContributors: number;
}
const { items, period, privacyMinimumContributors } = Astro.props as Props;
const formatMoney = (micros: number | null, currency: string): string => micros === null
  ? "Price pending"
  : new Intl.NumberFormat("en-US", { style: "currency", currency, maximumFractionDigits: 0 }).format(micros / 1_000_000);
const compact = (value: number): string => new Intl.NumberFormat("en-US", { notation: "compact", maximumFractionDigits: 1 }).format(value);
const periods: SubscriptionPeriod[] = ["7d", "30d", "90d"];
---
<section id="subscriptions" class="subscription-ranking" aria-labelledby="subscription-ranking-title">
  <div class="page-inner subscription-ranking-inner">
    <header class="subscription-heading">
      <div>
        <span class="subscription-eyebrow">Measured from coding sessions</span>
        <h2 id="subscription-ranking-title">Best coding subscriptions right now</h2>
        <p>Token allowance, model mix, API-equivalent value, and optional result satisfaction—kept separate and confidence-weighted.</p>
      </div>
      <nav aria-label="Subscription ranking period">
        {periods.map((option) => <a class:list={{ active: period === option }} href={`?planPeriod=${option}#subscriptions`}>{option}</a>)}
      </nav>
    </header>

    <div class="subscription-method-note">
      <strong>“Best” is not the biggest raw token count.</strong>
      <span>Plans rank only after model prices cover ≥80% of tokens and at least {privacyMinimumContributors} independent contributors opt in.</span>
      <a href="#methodology">Methodology</a>
    </div>

    <div class="subscription-table-wrap">
      <table>
        <thead><tr><th>Rank</th><th>Subscription</th><th>Value</th><th>Observed allowance</th><th>Results</th><th>Evidence</th></tr></thead>
        <tbody>
          {items.map((item, index) => {
            const ready = item.qualityAdjustedValueScore !== null;
            return <tr>
              <td class="subscription-rank">{ready ? index + 1 : "—"}</td>
              <td>
                <a class="subscription-plan" href={item.officialUrl} target="_blank" rel="noreferrer"><strong>{item.name}</strong><span>{item.providerName} · {formatMoney(item.priceMicros, item.currency)}/{item.billingPeriod === "monthly" ? "mo" : item.billingPeriod}</span></a>
              </td>
              <td>{ready ? <span class="subscription-score"><strong>{item.qualityAdjustedValueScore}</strong><small>/100 adjusted value</small>{item.apiEquivalentMicros !== null && <small>{formatMoney(item.apiEquivalentMicros, item.currency)} median API-equivalent</small>}{item.changePercent !== null && <small class:list={{ "subscription-change-up": item.changePercent > 0, "subscription-change-down": item.changePercent < 0 }}>{item.changePercent > 0 ? "▲" : item.changePercent < 0 ? "▼" : "•"} {Math.abs(item.changePercent)}% observed value vs prior snapshot</small>}</span> : <span class="subscription-pending">Pending</span>}</td>
              <td>
                {item.contributorCount > 0
                  ? <details><summary><strong>{compact(item.medianTokensPerSubscription ?? item.observedTokens)}</strong><span>median tokens/subscriber</span></summary><div class="model-mix">{item.modelMix.slice(0, 8).map((mix) => <p><b>{mix.model}</b><span>{mix.reasoningEffort} · {mix.querySource}</span><strong>{mix.sharePercent}%</strong></p>)}</div></details>
                  : <span class="subscription-muted">Collecting private sample</span>}
              </td>
              <td>{item.satisfactionScore === null ? <span class="subscription-muted">Not enough contributors</span> : <><strong>{item.satisfactionScore}/100</strong><small>{item.satisfactionCount} contributors</small></>}</td>
              <td>{item.contributorCount === 0 ? <span class="subscription-muted">Fewer than {privacyMinimumContributors}</span> : <><strong>{item.confidence}%</strong><small>{item.contributorCount} contributors · {item.exactSlicePercent}% exact</small></>}</td>
            </tr>;
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .subscription-ranking { border-block: 1px solid var(--color-rule); background: var(--color-paper-2); }
  .subscription-ranking-inner { padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 4vw, 3rem); }
  .subscription-heading { display:flex; align-items:end; justify-content:space-between; gap:2rem; margin-bottom:1.5rem; }
  .subscription-heading h2 { max-width:18ch; margin:.35rem 0 .5rem; font-size:clamp(2rem,5vw,4rem); line-height:.98; }
  .subscription-heading p { max-width:62ch; margin:0; color:var(--color-muted); }
  .subscription-eyebrow { color:var(--color-accent); font:700 .72rem/1 var(--font-mono); letter-spacing:.12em; text-transform:uppercase; }
  .subscription-heading nav { display:flex; padding:.25rem; border:1px solid var(--color-rule); border-radius:999px; background:var(--color-paper); }
  .subscription-heading nav a { padding:.55rem .8rem; border-radius:999px; color:var(--color-muted); font:700 .76rem/1 var(--font-mono); text-decoration:none; }
  .subscription-heading nav a.active { background:var(--color-ink); color:var(--color-paper); }
  .subscription-method-note { display:flex; align-items:center; gap:.75rem 1.25rem; padding:1rem 1.25rem; border:1px solid var(--color-rule); border-bottom:0; background:var(--color-paper); font-size:.82rem; }
  .subscription-method-note span { flex:1; color:var(--color-muted); }
  .subscription-method-note a { color:var(--color-ink); font-weight:700; }
  .subscription-table-wrap { overflow:auto; border:1px solid var(--color-rule); background:var(--color-paper); }
  table { width:100%; min-width:960px; border-collapse:collapse; }
  th { padding:.8rem 1rem; border-bottom:1px solid var(--color-rule); color:var(--color-muted); font:700 .68rem/1 var(--font-mono); letter-spacing:.08em; text-align:left; text-transform:uppercase; }
  td { padding:1rem; border-bottom:1px solid var(--color-rule); vertical-align:middle; }
  tbody tr:last-child td { border-bottom:0; }
  td > small, td > span + small, details summary span { display:block; margin-top:.2rem; color:var(--color-muted); font-size:.72rem; }
  .subscription-rank { width:4rem; font:700 1rem/1 var(--font-mono); }
  .subscription-plan { display:grid; gap:.25rem; color:inherit; text-decoration:none; }
  .subscription-plan span { color:var(--color-muted); font-size:.76rem; }
  .subscription-score strong { font:700 1.5rem/1 var(--font-display); }
  .subscription-score small { color:var(--color-muted); }
  .subscription-score .subscription-change-up { color:#16794a; }
  .subscription-score .subscription-change-down { color:#b33b32; }
  .subscription-pending { display:inline-flex; padding:.35rem .55rem; border:1px solid var(--color-rule); border-radius:999px; color:var(--color-muted); font:700 .68rem/1 var(--font-mono); text-transform:uppercase; }
  .subscription-muted { color:var(--color-muted); font-size:.78rem; }
  details summary { cursor:pointer; list-style:none; }
  details summary::-webkit-details-marker { display:none; }
  .model-mix { min-width:22rem; margin-top:.75rem; padding-top:.6rem; border-top:1px solid var(--color-rule); }
  .model-mix p { display:grid; grid-template-columns:minmax(9rem,1fr) minmax(8rem,1fr) auto; gap:.75rem; margin:.4rem 0; font-size:.7rem; }
  .model-mix span { color:var(--color-muted); }
  @media (max-width:760px) {
    .subscription-heading { align-items:start; flex-direction:column; }
    .subscription-method-note { align-items:start; flex-direction:column; border-bottom:1px solid var(--color-rule); }
    .subscription-table-wrap { border-top:0; }
  }
</style>

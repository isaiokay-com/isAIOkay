---
import TrendChart from "./TrendChart.astro";
import ModelLogo from "./ModelLogo.astro";
import type { RankingItem } from "../types";
import { modelPagePath } from "../lib/model-pages";

interface Props { items: RankingItem[]; selectedSlug: string | null; rankOffset?: number; showRankMovement?: boolean; }
const { items, selectedSlug, rankOffset = 0, showRankMovement = true } = Astro.props;
const params = new URL(Astro.request.url).searchParams;
const linkFor = (updates: Record<string, string | null>) => {
  const next = new URLSearchParams(params);
  for (const [key, value] of Object.entries(updates)) value === null ? next.delete(key) : next.set(key, value);
  const query = next.toString();
  return `/${query ? `?${query}` : ""}`;
};
const directionClass = (value: number) => value > 0.2 ? "change-positive" : value < -0.2 ? "change-negative" : "change-neutral";
const signed = (value: number | null) => value === null ? "Not available" : `${value > 0 ? "+" : ""}${value.toFixed(1)}`;
const ratingHref = (slug: string) => `${linkFor({ feedback: slug })}#feedback`;
const expandHref = (slug: string) => selectedSlug === slug ? `${linkFor({ item: null })}#rankings` : `${linkFor({ item: slug })}#item-${slug}`;
const rankLabel = (index: number) => String(index + 1 + rankOffset);
const countLabel = (value: number, singular: string, plural = `${singular}s`) => `${value.toLocaleString()} ${value === 1 ? singular : plural}`;
const confidenceDots = (confidence: number) => Math.round(Math.max(0, Math.min(100, confidence)) / 20);
const movement = (item: RankingItem) => {
  if (item.rankChange === null) return item.reportCount > 0
    ? { label: "NEW", className: "movement-new" }
    : { label: "Awaiting ratings", className: "movement-neutral" };
  if (item.rankChange > 0) return { label: `▲ +${item.rankChange}`, className: "movement-up" };
  if (item.rankChange < 0) return { label: `▼ ${item.rankChange}`, className: "movement-down" };
  return { label: "No move", className: "movement-neutral" };
};
const baselineLabel = (item: RankingItem) => item.baselineEvidenceStatus === "available"
  ? `Result quality since documented release: ${signed(item.resultQualityChangeSinceRelease)}`
  : item.baselineEvidenceStatus === "collecting"
    ? "Release baseline is still collecting"
    : item.baselineEvidenceStatus === "insufficient_evidence"
      ? "Release window did not collect enough evidence"
      : "No documented release baseline yet";
const status = (item: RankingItem) => {
  if (item.reportCount === 0) return { label: "Collecting", className: "status-collecting" };
  if (item.possibleDegradationSinceRelease || item.state === "degrading") return { label: "Declining", className: "status-declining" };
  if (item.state === "improving") return { label: "Trending", className: "status-trending" };
  return { label: "Stable", className: "status-stable" };
};
---
<div class="desktop-table ranking-frame" id="rankings" tabindex="-1">
  <table class="ranking-table">
    <caption class="visually-hidden">Current developer experience ratings for AI coding models. Select a model to expand its recent and release evidence.</caption>
    <thead>
      <tr>
        <th scope="col">Rank</th>
        <th scope="col">Model</th>
        <th scope="col">Developer Signal</th>
        <th scope="col">Trend (7d)</th>
        <th scope="col">Status</th>
        <th scope="col">Confidence</th>
        <th scope="col">Developers</th>
        <th scope="col"><span class="visually-hidden">Rate</span></th>
      </tr>
    </thead>
    <tbody>
      {items.map((item, index) => {
        const rank = index + 1 + rankOffset;
        const currentMovement = movement(item);
        const filledDots = confidenceDots(item.confidence);
        const currentStatus = status(item);
        return <Fragment>
          <tr class:list={["ranking-row", { "ranking-row--regression": item.possibleDegradationSinceRelease }]} id={`item-${item.slug}`}>
            <td class="rank-cell">
              <span class="rank-position">
                <span class:list={["rank-number", { "rank-number--podium": rank <= 3, [`rank-number--${rank}`]: rank <= 3 }]} aria-label={`Rank ${rank}`}>{rankLabel(index)}</span>
                {showRankMovement && item.rankChange !== null && item.rankChange !== 0 && <span class:list={["rank-shift", { "rank-shift--up": item.rankChange > 0, "rank-shift--down": item.rankChange < 0 }]} aria-label={`${item.rankChange > 0 ? "Up" : "Down"} ${Math.abs(item.rankChange)} position${Math.abs(item.rankChange) === 1 ? "" : "s"}`} title={`${item.rankChange > 0 ? "Up" : "Down"} ${Math.abs(item.rankChange)} since the previous ranking`}><span aria-hidden="true">{item.rankChange > 0 ? "↑" : "↓"}</span>{Math.abs(item.rankChange)}</span>}
              </span>
            </td>
            <td>
              <div class="rank-item-actions">
                <a href={modelPagePath(item)} class="rank-item-link">
                  <ModelLogo name={item.name} providerName={item.providerName} logoUrl={item.logoUrl} />
                  <span class="tool-copy">
                    <strong>{item.name}</strong>
                    <span class="tool-provider">by {item.providerName}</span>
                    <span class="tool-description">{item.description ?? `${item.providerName} coding model`}</span>
                    {item.possibleDegradationSinceRelease && <span class="regression-flag">Possible regression since release</span>}
                  </span>
                </a>
                <a href={expandHref(item.slug)} class="rank-quick-view" aria-expanded={selectedSlug === item.slug ? "true" : "false"} aria-controls={`details-${item.slug}`}>
                  {selectedSlug === item.slug ? "Close" : "Quick view"}
                </a>
              </div>
            </td>
            <td>
              {item.reportCount > 0
                ? <span class="developer-score"><strong>{item.overallScore}</strong><small>/100</small></span>
                : <span class="pending-score">Pending</span>}
            </td>
            <td>
              <div class="trend-cell">
                <TrendChart trend={item.trend} compact label={`${item.name} seven-day Developer Signal`} />
                <span class={`movement ${currentMovement.className}`}>{currentMovement.label}</span>
              </div>
            </td>
            <td><span class={`status-label ${currentStatus.className}`}>{currentStatus.label}</span></td>
            <td>
              <span class="confidence-meter" title={`${item.confidence}% confidence`} aria-label={`${item.confidence}% confidence`}>
                {[0, 1, 2, 3, 4].map((dot) => <span class:list={["confidence-dot", { "confidence-dot--filled": dot < filledDots }]}></span>)}
              </span>
            </td>
            <td><span class="developer-count"><strong>{countLabel(item.developerCount, "developer")}</strong><small>{countLabel(item.reportCount, "rating")}</small></span></td>
            <td class="rate-cell"><a class="button-dark" href={ratingHref(item.slug)} data-feedback-item={item.slug}>Rate</a></td>
          </tr>
          {selectedSlug === item.slug && <tr id={`details-${item.slug}`} class="expanded-row"><td colspan="8">
            <section class="expanded-panel" aria-label={`${item.name} details`}>
              <div class="expanded-heading">
                <div><strong>Recent experience evidence</strong><p>{baselineLabel(item)}. A possible regression is a community signal, never a claim about provider intent.</p></div>
                <a class="button-dark" href={ratingHref(item.slug)} data-feedback-item={item.slug}>Rate {item.name}</a>
              </div>
              <div class="details-grid">
                <div class="details-card">
                  <span class="details-label">Seven-day trend</span>
                  <TrendChart trend={item.trend} />
                  <span class={`detail-change ${directionClass(item.resultQualityChangeVsPrevious)}`}>Result quality vs prior window: {signed(item.resultQualityChangeVsPrevious)}</span>
                </div>
                <div class="details-card">
                  <span class="details-label">Dimension scores</span>
                  <div class="dimension-grid"><span>Result quality <b>{item.reportCount > 0 ? item.resultQualityScore : "Pending"}</b></span><span>Usage efficiency <b>{item.reportCount > 0 ? item.usageEfficiencyScore : "Pending"}</b></span></div>
                </div>
                <div class="details-card">
                  <span class="details-label">Usage pressure</span>
                  <p class="release-summary">{item.reportCount > 0 ? `${item.usageEfficiencyScore}/100 usage efficiency` : "Usage efficiency pending"}</p>
                  <p>How much useful progress developers felt they received for the subscription or usage consumed.</p>
                </div>
                <div class="details-card">
                  <span class="details-label">Release signal</span>
                  <p class="release-summary">{baselineLabel(item)}</p>
                  {item.releaseBaselineResultQuality !== null && <div class="release-comparison"><span>Release result quality <b>{item.releaseBaselineResultQuality}</b></span><span>Current result quality <b>{item.resultQualityScore}</b></span></div>}
                  {item.releaseSourceUrl && <a class="detail-link" href={item.releaseSourceUrl} rel="noreferrer" target="_blank">View release reference</a>}
                  {item.officialUrl && <a class="detail-link" href={item.officialUrl} rel="noreferrer" target="_blank">Official model page</a>}
                </div>
                {item.agentContexts.length > 0 && <div class="details-card details-card--agents">
                  <span class="details-label">By coding agent</span>
                  <div class="agent-context-list">{item.agentContexts.map((context) => <span><b>{context.agentName}</b><strong>{context.overallScore}/100</strong><small>{countLabel(context.reportCount, "rating")} from {countLabel(context.developerCount, "developer")}</small></span>)}</div>
                  <p>Shown only with at least 5 eligible ratings from 3 developers. These slices are contextual evidence, not separate rankings.</p>
                </div>}
              </div>
            </section>
          </td></tr>}
        </Fragment>;
      })}
    </tbody>
  </table>
</div>

<section class="mobile-cards" aria-label="Ranking cards" id="mobile-rankings">
  {items.map((item, index) => {
    const rank = index + 1 + rankOffset;
    const currentMovement = movement(item);
    const filledDots = confidenceDots(item.confidence);
    const currentStatus = status(item);
    return <article class="mobile-card-shell">
      <details class:list={["mobile-card", { "mobile-card--regression": item.possibleDegradationSinceRelease }]} open={selectedSlug === item.slug} id={`mobile-${item.slug}`}>
        <summary>
          <span class="rank-position">
            <span class:list={["mobile-rank", { "rank-number--podium": rank <= 3, [`rank-number--${rank}`]: rank <= 3 }]} aria-label={`Rank ${rank}`}>{rankLabel(index)}</span>
            {showRankMovement && item.rankChange !== null && item.rankChange !== 0 && <span class:list={["rank-shift", { "rank-shift--up": item.rankChange > 0, "rank-shift--down": item.rankChange < 0 }]} aria-label={`${item.rankChange > 0 ? "Up" : "Down"} ${Math.abs(item.rankChange)} position${Math.abs(item.rankChange) === 1 ? "" : "s"}`}><span aria-hidden="true">{item.rankChange > 0 ? "↑" : "↓"}</span>{Math.abs(item.rankChange)}</span>}
          </span>
          <ModelLogo name={item.name} providerName={item.providerName} logoUrl={item.logoUrl} />
          <span class="mobile-tool-copy"><strong>{item.name}</strong><small>by {item.providerName}</small></span>
          {item.reportCount > 0 ? <span class="developer-score"><strong>{item.overallScore}</strong><small>/100</small></span> : <span class="pending-score">Pending</span>}
        </summary>
        <div class="mobile-signal-row">
          <TrendChart trend={item.trend} compact label={`${item.name} seven-day Developer Signal`} />
          <span class={`movement ${currentMovement.className}`}>{currentMovement.label}</span>
        </div>
        <div class="mobile-facts">
          <span><small>Status</small><b>{currentStatus.label}</b></span>
          <span><small>Developers</small><b>{item.developerCount.toLocaleString()}</b></span>
          <span><small>Ratings</small><b>{item.reportCount.toLocaleString()}</b></span>
          <span><small>Confidence</small><span class="confidence-meter" aria-label={`${item.confidence}% confidence`}>{[0, 1, 2, 3, 4].map((dot) => <span class:list={["confidence-dot", { "confidence-dot--filled": dot < filledDots }]}></span>)}</span></span>
        </div>
        {item.possibleDegradationSinceRelease && <p class="regression-flag">Possible regression since release</p>}
        <div class="mobile-dimensions"><div>Result quality <b>{item.reportCount > 0 ? item.resultQualityScore : "Pending"}</b></div><div>Usage efficiency <b>{item.reportCount > 0 ? item.usageEfficiencyScore : "Pending"}</b></div></div>
        <p class="mobile-baseline">{baselineLabel(item)}</p>
        {item.agentContexts.length > 0 && <div class="mobile-agent-context"><small>By coding agent</small>{item.agentContexts.map((context) => <span><b>{context.agentName}</b><strong>{context.overallScore}/100</strong></span>)}<p>Minimum 5 ratings from 3 developers per agent.</p></div>}
        <a class="button-dark" href={ratingHref(item.slug)} data-feedback-item={item.slug}>Rate {item.name}</a>
      </details>
      <a class="mobile-history-link" href={modelPagePath(item)}>View full history for {item.name}</a>
    </article>;
  })}
</section>

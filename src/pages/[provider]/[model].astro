---
import BaseLayout from "../../components/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ModelHistoryChart from "../../components/ModelHistoryChart.astro";
import ModelLogo from "../../components/ModelLogo.astro";
import { getPublicModelHistory } from "../../db/repositories";
import { loadPublicRanking } from "../../lib/cache";
import { matchesModelPageRoute, modelPagePath } from "../../lib/model-pages";
import { getRuntimeEnv } from "../../lib/runtime";
import "../../styles/model.css";

export const prerender = false;

const providerParam = Astro.params.provider ?? "";
const modelParam = Astro.params.model ?? "";
const env = getRuntimeEnv(Astro.locals);
const { payload } = await loadPublicRanking(env, "live");
const matchedModel = payload.items.find((candidate) => matchesModelPageRoute(candidate, providerParam, modelParam)) ?? null;
const canonicalPath = matchedModel ? modelPagePath(matchedModel) : null;

if (matchedModel && Astro.url.pathname !== canonicalPath) {
  return Astro.redirect(canonicalPath!, 301);
}

const history = matchedModel ? await getPublicModelHistory(env, matchedModel.id) : null;
const item = matchedModel && history ? matchedModel : null;
if (!item) Astro.response.status = 404;
else Astro.response.headers.set("Cache-Control", "public, max-age=60, s-maxage=300, stale-while-revalidate=3600");

const formatDate = (value: number) => new Intl.DateTimeFormat("en", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
}).format(value);
const formatShortDate = (value: number) => new Intl.DateTimeFormat("en", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC"
}).format(value);
const signed = (value: number | null) => value === null ? "Not available" : `${value > 0 ? "+" : ""}${value.toFixed(1)}`;
const currentRank = item ? payload.items.findIndex((candidate) => candidate.id === item.id) + 1 : 0;
const trackedDays = history ? Math.max(1, Math.floor((Date.now() - history.addedAt) / 86_400_000) + 1) : 0;
const status = item?.reportCount === 0
  ? { label: "Collecting ratings", className: "collecting" }
  : item?.possibleDegradationSinceRelease || item?.state === "degrading"
    ? { label: "Declining signal", className: "declining" }
    : item?.state === "improving"
      ? { label: "Improving signal", className: "improving" }
      : { label: "Stable signal", className: "stable" };
const baselineCopy = !item ? ""
  : item.baselineEvidenceStatus === "available"
    ? `Result quality is ${signed(item.resultQualityChangeSinceRelease)} points versus its documented release baseline.`
    : item.baselineEvidenceStatus === "collecting"
      ? "The documented release baseline is still collecting eligible evidence."
      : item.baselineEvidenceStatus === "insufficient_evidence"
        ? "The release window did not collect enough evidence for a baseline comparison."
        : "No documented release baseline is available yet.";
const latestHistory = history?.points.at(-1) ?? null;
const historyRows = history ? [...history.points].reverse().slice(0, 14) : [];
const relatedModels = item ? [
  ...payload.items.filter((candidate) => candidate.id !== item.id && candidate.providerName === item.providerName),
  ...payload.items.filter((candidate) => candidate.id !== item.id && candidate.providerName !== item.providerName)
].slice(0, 4) : [];
const pageTitle = item ? `${item.name} Developer Experience Ratings | IsAIokay.com` : "Model not found | IsAIokay.com";
const pageDescription = item
  ? `See how ${item.name} ranks with developers. Explore daily result quality, usage efficiency, confidence, and signs of improvement or degradation.`
  : "This model is not currently tracked by IsAIokay.com";
const structuredData = item && history ? {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      name: `${item.name} developer experience history`,
      description: pageDescription,
      url: new URL(canonicalPath!, Astro.site ?? "https://isaiokay.com").toString(),
      dateCreated: new Date(history.addedAt).toISOString(),
      dateModified: payload.generatedAt,
      temporalCoverage: `${new Date(history.addedAt).toISOString()}/${payload.generatedAt}`,
      creator: { "@type": "Organization", name: "IsAIokay.com", url: "https://isaiokay.com/" },
      variableMeasured: ["Developer Signal", "Result quality", "Usage efficiency", "Confidence"],
      measurementTechnique: "Opt-in, recency-weighted developer experience ratings",
      about: { "@type": "SoftwareApplication", name: item.name, applicationCategory: "AI coding model", publisher: { "@type": "Organization", name: item.providerName } }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Models", item: "https://isaiokay.com/#ranking" },
        { "@type": "ListItem", position: 2, name: item.providerName },
        { "@type": "ListItem", position: 3, name: item.name, item: new URL(canonicalPath!, Astro.site ?? "https://isaiokay.com").toString() }
      ]
    }
  ]
} : undefined;
---
<BaseLayout title={pageTitle} description={pageDescription} imageAlt={item ? `${item.name} developer experience, trend, and ratings` : "AI coding model not found"} noindex={!item} structuredData={structuredData} analytics={Boolean(item)}>
  <div class="model-detail-shell">
    <Header generatedAt={payload.generatedAt} />
    <main id="main-content" class="model-page">
      {!item || !history ? (
        <section class="model-not-found">
          <p>Model directory</p>
          <h1>Model not found</h1>
          <p>This provider and model combination is not in the active catalog.</p>
          <a class="model-button model-button--primary" href="/#ranking">Browse tracked models</a>
        </section>
      ) : (
        <>
          <nav class="model-breadcrumbs" aria-label="Breadcrumb">
            <a href="/#ranking">Models</a><span aria-hidden="true">/</span><span>{item.providerName}</span><span aria-hidden="true">/</span><span aria-current="page">{item.name}</span>
          </nav>

          <section class="model-hero" aria-labelledby="model-title">
            <div class="model-identity">
              <ModelLogo name={item.name} providerName={item.providerName} logoUrl={item.logoUrl} hero />
              <div>
                <p>{item.providerName}{item.versionLabel ? ` · ${item.versionLabel}` : ""}</p>
                <h1 id="model-title">{item.name}</h1>
              </div>
            </div>
            <div class="model-hero-copy">
              <p>{item.description ?? `${item.providerName} model tracked through recent developer coding experiences.`}</p>
              <div class="model-hero-actions">
                <a class="model-button model-button--primary" href={`/?feedback=${item.slug}#feedback`}>Rate this model</a>
                {item.officialUrl && <a class="model-button model-button--secondary" href={item.officialUrl} rel="noreferrer" target="_blank">Official model page ↗</a>}
              </div>
            </div>
          </section>

          <div class="tracking-strip" aria-label="Catalog tracking details">
            <span><strong>Tracked since</strong>{formatDate(history.addedAt)}</span>
            <span><strong>Days tracked</strong>{trackedDays.toLocaleString()}</span>
            <span><strong>Latest update</strong>{formatShortDate(item.calculatedAt)}</span>
            <span class={`model-status model-status--${status.className}`}><i aria-hidden="true"></i>{status.label}</span>
          </div>

          <section class="signal-map" aria-labelledby="signal-history-title">
            <div class="signal-map-heading">
              <div>
                <h2 id="signal-history-title">Developer Signal over time</h2>
                <p>{history.points.length > 0 ? `${history.points.length.toLocaleString()} daily snapshot${history.points.length === 1 ? "" : "s"} since ${formatShortDate(history.points[0]!.at)}.` : `History begins after ${item.name} receives eligible ratings in a complete scoring run.`}</p>
              </div>
              <div class="current-signal" aria-label={item.reportCount > 0 ? `Current Developer Signal ${item.overallScore} out of 100` : "Developer Signal pending"}>
                <span>Current signal</span>
                {item.reportCount > 0 ? <strong>{item.overallScore}<small>/100</small></strong> : <strong class="current-signal-pending">Pending</strong>}
              </div>
            </div>
            <ModelHistoryChart points={history.points} modelName={item.name} />
          </section>

          <section class="model-evidence" aria-label="Current model evidence">
            <article class="evidence-primary">
              <h2>Current evidence</h2>
              <dl class="dimension-sheet">
                <div><dt>Recommended rank</dt><dd>{item.reportCount > 0 ? `#${currentRank}` : "Pending"}</dd><small>Current live ordering</small></div>
                <div><dt>Result quality</dt><dd>{item.reportCount > 0 ? item.resultQualityScore : "—"}</dd><small>How good the result was</small></div>
                <div><dt>Usage efficiency</dt><dd>{item.reportCount > 0 ? item.usageEfficiencyScore : "—"}</dd><small>Progress relative to usage consumed</small></div>
                <div><dt>Confidence</dt><dd>{item.confidence}%</dd><small>{item.developerCount.toLocaleString()} developer{item.developerCount === 1 ? "" : "s"}</small></div>
              </dl>
            </article>

            <aside class="evidence-notes">
              <div>
                <h2>Usage pressure</h2>
                <p class="usage-score"><strong>{item.reportCount > 0 ? item.usageEfficiencyScore : "—"}</strong><span>/100 usage efficiency</span></p>
                <p class="evidence-explainer">Whether the useful progress felt worth the subscription allowance or metered usage consumed. Low scores indicate usage felt burned too quickly.</p>
              </div>
              <div>
                <h2>Release evidence</h2>
                <p>{baselineCopy}</p>
                {item.releaseAt && <p>Documented release: <time datetime={new Date(item.releaseAt).toISOString()}>{formatDate(item.releaseAt)}</time>.</p>}
                {item.releaseSourceUrl && <a href={item.releaseSourceUrl} rel="noreferrer" target="_blank">View release reference ↗</a>}
              </div>
            </aside>
          </section>

          <section class="history-ledger" aria-labelledby="history-ledger-title">
            <div class="history-ledger-heading">
              <div><h2 id="history-ledger-title">Latest daily snapshots</h2><p>The most recent 14 available days, newest first.</p></div>
              {latestHistory && <span>{latestHistory.reportCount.toLocaleString()} eligible rating{latestHistory.reportCount === 1 ? "" : "s"} in latest window</span>}
            </div>
            {historyRows.length > 0 ? <div class="history-ledger-table" role="region" aria-label={`${item.name} latest daily scores`} tabindex="0">
              <table>
                <thead><tr><th scope="col">Date</th><th scope="col">Signal</th><th scope="col">Result quality</th><th scope="col">Usage efficiency</th><th scope="col">Confidence</th></tr></thead>
                <tbody>{historyRows.map((point) => <tr>
                  <th scope="row">{formatShortDate(point.at)}</th><td>{point.overallScore}</td><td>{point.resultQualityScore}</td><td>{point.usageEfficiencyScore}</td><td>{point.confidence}%</td>
                </tr>)}</tbody>
              </table>
            </div> : <p class="ledger-empty">No daily score snapshots are available yet.</p>}
          </section>

          <section class="model-method" aria-labelledby="method-title">
            <h2 id="method-title">What this trend measures</h2>
            <div>
              <p>IsAIokay.com aggregates opt-in ratings from developers who used the model in coding workflows. Recent reports carry more weight; confidence rises with eligible evidence and independent participation.</p>
              <p>This is community experience data, not an objective capability benchmark. A change in the line can reflect model behavior, serving conditions, tool integrations, task mix, or who reported during that period.</p>
              <a href="/#methodology">Read the scoring methodology</a>
            </div>
          </section>

          {relatedModels.length > 0 && <section class="related-models" aria-labelledby="related-title">
            <h2 id="related-title">Compare other models</h2>
            <div>{relatedModels.map((related) => <a href={modelPagePath(related)}>
              <span>{related.providerName}</span><strong>{related.name}</strong><small>{related.reportCount > 0 ? `${related.overallScore}/100 signal` : "Collecting ratings"}</small>
            </a>)}</div>
          </section>}
        </>
      )}
    </main>
    <footer class="model-footer">
      <strong>IsAIokay.com</strong>
      <nav aria-label="Footer"><a href="/#ranking">Models</a><a href="/#methodology">Methodology</a><a href="/#cli">CLI</a><a href="/privacy">Privacy</a></nav>
      <span>Community experience, with the uncertainty left in.</span>
    </footer>
  </div>
</BaseLayout>

---
import BaseLayout from "../components/BaseLayout.astro";
import Header from "../components/Header.astro";

export const prerender = false;
Astro.response.status = 404;
---
<BaseLayout
  title="Page not found | IsAIokay.com"
  description="The requested page could not be found on IsAIokay.com."
  noindex
>
  <Header />
  <main id="main-content" class="not-found-page">
    <div class="not-found-code" aria-hidden="true">404</div>
    <div class="not-found-copy">
      <p class="eyebrow">Nothing measured here</p>
      <h1>Page not found.</h1>
      <p>The address may be wrong, or the page may have moved. The coding-subscription rankings are still available on the homepage.</p>
      <div class="not-found-actions">
        <a class="button-dark" href="/">View subscription rankings</a>
        <a class="button-light" href="https://github.com/isaiokay-com/isAIOkay" rel="noreferrer" target="_blank">View source <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found-page {
    display: grid;
    min-height: calc(100vh - 9rem);
    grid-template-columns: minmax(12rem, .7fr) minmax(20rem, 1.3fr);
    align-items: center;
    gap: clamp(2.5rem, 8vw, 8rem);
    padding: clamp(3rem, 8vw, 7rem) clamp(1.25rem, 6vw, 5.5rem);
    border-bottom: 1px solid var(--line);
  }

  .not-found-code {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: clamp(6rem, 18vw, 15rem);
    font-weight: 700;
    letter-spacing: -.12em;
    line-height: .72;
  }

  .not-found-copy { max-width: 42rem; }
  .not-found-copy h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.5rem, 6vw, 5.25rem);
    font-weight: 850;
    letter-spacing: -.07em;
    line-height: .98;
  }

  .not-found-copy > p:not(.eyebrow) {
    max-width: 36rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: clamp(.95rem, 1.4vw, 1.1rem);
    line-height: 1.7;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: .75rem;
    margin-top: 2rem;
  }

  @media (max-width: 700px) {
    .not-found-page {
      min-height: calc(100vh - 7rem);
      grid-template-columns: 1fr;
      align-content: center;
      gap: 2.5rem;
    }

    .not-found-code { font-size: clamp(5.5rem, 30vw, 9rem); }
  }
</style>

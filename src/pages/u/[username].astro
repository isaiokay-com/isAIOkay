---
import BaseLayout from "../../components/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ProfileRatingsList from "../../components/islands/ProfileRatingsList";
import ProfileVisibilityControl from "../../components/islands/ProfileVisibilityControl";
import { getFeedbackAllowance, getPublicProfileView } from "../../db/repositories";
import { PROFILE_OG_IMAGE_VERSION } from "../../lib/profile-og";
import { getRuntimeEnv } from "../../lib/runtime";
import { getCurrentIdentity } from "../../services/auth";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "private, no-store");

const username = Astro.params.username ?? "";
const env = getRuntimeEnv(Astro.locals);
const identity = await getCurrentIdentity(Astro.request, env);
const profile = await getPublicProfileView(env, username, identity?.userId ?? null);
if (!profile) Astro.response.status = 404;
if (profile && username !== profile.username) return Astro.redirect(`/u/${encodeURIComponent(profile.username)}`, 301);

const allowance = profile?.isOwner && identity ? await getFeedbackAllowance(env, identity.userId) : null;
const allowanceLabel = allowance?.remaining === 2 ? "You have 2 ratings available" : allowance?.remaining === 1 ? "You have 1 rating available" : null;

const renderedAt = Date.now();
const reportLabel = profile?.reportCount === 1 ? "1 model rating" : `${profile?.reportCount ?? 0} model ratings`;
const pageTitle = profile ? `${profile.displayName} (@${profile.username}) AI model ratings | IsAIokay.com` : "Profile not found | IsAIokay.com";
const pageDescription = profile
  ? `${profile.displayName} (@${profile.username}) has shared ${reportLabel} about AI coding models on IsAIokay.com.`
  : "This developer profile is private or unavailable.";
const socialImage = profile?.isPublic
  ? `/og/profile/${encodeURIComponent(profile.username)}.png?v=${PROFILE_OG_IMAGE_VERSION}`
  : undefined;
const structuredData = profile?.isPublic ? {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  name: `${profile.displayName}'s AI coding model ratings`,
  description: pageDescription,
  url: `https://isaiokay.com/u/${encodeURIComponent(profile.username)}`,
  dateModified: profile.reports[0] ? new Date(profile.reports[0].submittedAt).toISOString() : undefined,
  isPartOf: {
    "@type": "WebSite",
    name: "IsAIokay.com",
    url: "https://isaiokay.com/"
  },
  mainEntity: {
    "@type": "Person",
    name: profile.displayName,
    alternateName: `@${profile.username}`,
    url: `https://isaiokay.com/u/${encodeURIComponent(profile.username)}`,
    image: profile.avatarUrl ?? undefined,
    identifier: {
      "@type": "PropertyValue",
      propertyID: "GitHub username",
      value: profile.username
    },
    sameAs: [
      `https://github.com/${encodeURIComponent(profile.username)}`,
      ...(profile.xUsername ? [`https://x.com/${encodeURIComponent(profile.xUsername)}`] : [])
    ]
  }
} : undefined;

---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image={socialImage}
  imageAlt={profile ? `${profile.displayName}'s IsAIokay.com developer profile with their avatar and model ratings` : "Private developer profile"}
  noindex={!profile || !profile.isPublic}
  type="profile"
  profileUsername={profile?.isPublic ? profile.username : undefined}
  structuredData={structuredData}
>
  <Header />
  <main id="main-content" class="profile-page">
    {!profile ? <section class="profile-empty"><h1>This profile is private</h1><p>The developer has not enabled public ratings.</p><a class="button-light" href="/">View model rankings</a></section> : <>
      <section class="profile-card" aria-labelledby="profile-name">
        <div class="profile-card-main">
          <span class="profile-avatar">
            {profile.avatarUrl
              ? <img src={profile.avatarUrl} alt={`${profile.displayName}'s GitHub avatar`} width="128" height="128" referrerpolicy="no-referrer" fetchpriority="high" />
              : <span aria-hidden="true">{profile.displayName.slice(0, 1).toUpperCase()}</span>}
          </span>
          <div class="profile-identity">
            <h1 id="profile-name">{profile.displayName}</h1>
            <p class="profile-intro">Recent ratings for the AI coding models this developer has used.</p>
            <div class="profile-socials" aria-label="Social profiles">
              <a href={`https://github.com/${encodeURIComponent(profile.username)}`} rel="noreferrer" target="_blank" aria-label={`Open ${profile.username} on GitHub`} title={`${profile.username} on GitHub`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18A10.96 10.96 0 0 1 12 6.1c.98 0 1.95.13 2.86.38 2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.29c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
                <span>@{profile.username}</span>
              </a>
              {profile.xUsername && <a href={`https://x.com/${encodeURIComponent(profile.xUsername)}`} rel="noreferrer" target="_blank" aria-label={`Open @${profile.xUsername} on X (self-declared)`} title={`@${profile.xUsername} on X · self-declared`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.25-8.29L2.97 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.73L8.43 4.05H6.58L17.8 19.84Z" /></svg>
                <span>@{profile.xUsername}</span>
              </a>}
            </div>
          </div>
          {profile.isOwner && <div class="profile-edit-slot"><ProfileVisibilityControl client:load initialPublic={profile.isPublic} initialXUsername={profile.xUsername} /></div>}
        </div>
        <dl class="profile-stats-strip" aria-label="Profile rating summary">
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 4 2.47 5.18 5.53.66-4.06 3.9 1.06 5.63L12 16.6l-4.99 2.77 1.06-5.63-4.06-3.9 5.53-.66Z" /></svg>
            <dt>Ratings</dt><dd>{profile.reportCount}</dd>
          </div>
          <div>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 8.5 12 4l8.5 4.5L12 13Z" /><path d="M3.5 8.5V16l8.5 4.5V13" /><path d="M20.5 8.5V16L12 20.5" /></svg>
            <dt>Models</dt><dd>{profile.mostUsedModels.length}</dd>
          </div>
          {profile.isOwner && <div class="profile-visibility">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.25" /><path d="M3.75 12h16.5M12 3.75c2.2 2.3 3.3 5.2 3.3 8.25s-1.1 5.95-3.3 8.25c-2.2-2.3-3.3-5.2-3.3-8.25S9.8 6.05 12 3.75Z" /></svg>
            <span class="profile-visibility-badge" data-public={profile.isPublic}>{profile.isPublic ? "Public" : "Private"}</span>
          </div>}
        </dl>
      </section>

      {allowanceLabel && <section class="profile-allowance-banner">
        <span class="profile-allowance-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 8.5H4V12h16Z" /><path d="M5 12h14v7.5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1Z" /><path d="M12 8.5v12" /><path d="M12 8.5c-1.2 0-3.6-.4-4.6-1.9-.5-.75-.2-1.9.9-2.2 1.5-.4 3 1 3.7 4.1Z" /><path d="M12 8.5c1.2 0 3.6-.4 4.6-1.9.5-.75.2-1.9-.9-2.2-1.5-.4-3 1-3.7 4.1Z" /></svg>
        </span>
        <div class="profile-allowance-copy">
          <strong>{allowanceLabel}</strong>
          <p>Use your ratings to share structured feedback on the AI coding models you use.</p>
        </div>
        <a class="button-dark" href="/">Rate a model</a>
      </section>}

      <div class="profile-content-grid">
        <section class="profile-models" aria-labelledby="used-models-title">
          <div class="profile-section-heading"><h2 id="used-models-title">Most reported</h2><p>Models ranked by this developer’s number of public ratings.</p></div>
          {profile.mostUsedModels.length > 0 ? <ol class="profile-model-list">{profile.mostUsedModels.map((model, index) => <li><a href={`/?item=${model.slug}#item-${model.slug}`}><span>{String(index + 1).padStart(2, "0")}</span><strong>{model.name}</strong><small>{model.reports}</small></a></li>)}</ol> : <div class="profile-zero">
            <span class="profile-zero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="6" rx="7" ry="2.75" /><path d="M5 6v6c0 1.52 3.13 2.75 7 2.75s7-1.23 7-2.75V6" /><path d="M5 12v6c0 1.52 3.13 2.75 7 2.75s7-1.23 7-2.75v-6" /></svg></span>
            <p class="profile-zero-title">No models rated yet</p>
            <p class="profile-zero-copy">Once you rate models, the ones you contribute to most will appear here.</p>
            {profile.isOwner && <a class="button-light" href="/">Rate your first model</a>}
          </div>}
        </section>

        <section class="profile-activity" aria-labelledby="ratings-title">
          <div class="profile-section-heading"><h2 id="ratings-title">Ratings</h2><p>Only structured ratings are shown, newest first.</p></div>
          {profile.reports.length > 0 ? <ProfileRatingsList client:visible initialReports={profile.reports} initialCursor={profile.ratingsNextCursor} username={profile.username} renderedAt={renderedAt} /> : <div class="profile-zero profile-zero--activity">
            <span class="profile-zero-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 5.5h16v11H9.5L5 20.5v-4H4Z" /></svg></span>
            <p class="profile-zero-title">No public ratings yet</p>
            <p class="profile-zero-copy">{profile.isOwner ? "Your public model ratings will appear here once you start contributing." : "This developer’s public model ratings will appear here once they start contributing."}</p>
            {profile.isOwner && <a class="button-light" href="/">Explore model rankings</a>}
          </div>}
        </section>
      </div>
    </>}
  </main>
</BaseLayout>
